<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Fondo transparente -->
    <solid android:color="@android:color/transparent" />

    <!-- Borde neón grueso -->
    <stroke
        android:width="8dp"
        android:color="#FF00FF" />  <!-- Fucsia neón -->

    <!-- Esquinas redondeadas (opcional) -->
    <corners android:radius="16dp" />

    <!-- Un poco de padding interno -->
    <padding
        android:left="6dp"
        android:top="6dp"
        android:right="6dp"
        android:bottom="6dp" />
</shape>
