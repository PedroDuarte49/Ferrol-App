<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_retro">

    <!-- TÍTULO ARCADE -->
    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HIGH MOUNTAIN"
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="@color/neon_yellow"
        android:shadowColor="@color/neon_pink"
        android:shadowDx="3"
        android:shadowDy="3"
        android:shadowRadius="6"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="48dp"/>

    <!-- SUBTÍTULO -->
    <TextView
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PRESS START"
        android:textSize="14sp"
        android:textColor="@color/neon_blue"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <!-- BOTÓN SCOREBOARD -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_scoreboard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="SCOREBOARD"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="#E0D7FF"
        android:background="@drawable/btn_arcade_glow"
        android:padding="14dp"
        app:layout_constraintTop_toBottomOf="@id/subtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="48dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"/>

    <!-- BOTÓN FOROS -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_foros"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="FOROS"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="#E0D7FF"
        android:background="@drawable/btn_arcade_glow"
        android:padding="14dp"
        app:layout_constraintTop_toBottomOf="@id/btn_scoreboard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        />

    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:src="@drawable/cosoas"
        android:contentDescription="Logo"
        app:layout_constraintTop_toBottomOf="@id/btn_foros"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

</androidx.constraintlayout.widget.ConstraintLayout>

